# Consistent whitespace across Go, Kotlin, YAML and Markdown.
# Supported natively by Android Studio/IntelliJ, VS Code (with extension) and gofmt-adjacent tooling.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.go]
indent_style = tab
indent_size = 4

[*.{kt,kts}]
indent_size = 4
# ktlint reads these
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
