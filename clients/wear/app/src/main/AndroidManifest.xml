<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The watch talks to the agent itself. It does not proxy through the phone
         (clients/wear/README.md), so it needs the network on its own. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Ambient (M5.10). Wear requires WAKE_LOCK for an app to stay on screen dimmed
         rather than being replaced by the watch face. It does not let CueSeek hold the
         CPU awake in the background: the app has no service, no worker and no timer, and
         the one thing ambient does is *stop* polling. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Refuses to install on anything that is not a watch. Better than installing and
         then rendering a round-screen layout on a phone. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- The tile (M5.11). Runs in this app's process but renders through the system's
             Tiles carousel, which is why the permission is the system's to hold rather
             than ours to request. -->
        <service
            android:name=".tile.CueSeekTileService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>

            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Ambient support rides on Wear's shared library, and an app that does not
             declare it is simply never told the screen dimmed — no error, no warning, the
             broadcast is enqueued and nothing receives it. `required="false"` so the APK
             still installs on a device without it; the observer then reports that ambient
             is unavailable rather than the app failing to start. -->
        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Standalone: usable without the phone app present.
             ADR-0014 qualifies this precisely — the watch is standalone at RUNTIME but
             not for first-run setup, where the phone hands over the agent's address. The
             manual address field is the fallback that keeps this declaration honest. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- allowBackup is false for the same reason as the phone client: the token is
             sealed by a Keystore key that does not survive a restore, so a backed-up copy
             would produce a watch that believes it is paired and fails every request
             (ADR-0006 Amendment 2). -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
