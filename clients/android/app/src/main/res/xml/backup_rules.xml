<?xml version="1.0" encoding="utf-8"?>
<!--
  API 30 and below. The API 31+ equivalent is data_extraction_rules.xml, which carries the
  reasoning; this file exists so devices on the older backup mechanism behave the same way
  rather than quietly backing up a credential store that cannot survive the trip.

  minSdk is 26, so this range is real rather than theoretical.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
