<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon. The foreground is the graded mark; the monochrome layer is the flat one,
  because a themed icon is a single tinted colour and a gradient has nothing to say there.
  All three drawables are generated by docs/brand/icon.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
