# CueSeek host agent.
#
# Install to:  /etc/systemd/system/cueseekd.service   (root:root, 0644)
#
# Runs as its own unprivileged user and holds no capabilities. Everything
# privileged is a request to systemd or logind over D-Bus, authorised by
# /etc/polkit-1/rules.d/10-cueseek.rules (ADR-0002). If that rule is absent the
# agent still starts and still serves health — it simply cannot restart anything.

[Unit]
Description=CueSeek host agent
Documentation=https://github.com/Kushal-MR/CueSeek

# D-Bus is not optional: it is how the agent reads unit state and requests
# restarts. Without it the host layer fails at startup rather than at first use.
Requires=dbus.socket
After=dbus.socket network-online.target
Wants=network-online.target

# NO tailscaled ordering, and this is now a measurement rather than an assumption.
#
# M2 left "add After=tailscaled.service" as an open item. M3.8 added it, deployed it and
# rebooted the host to check. It made no difference — the agent still retried, and on that
# boot retried *more* than on unordered boots:
#
#   without ordering   waited=2s attempts=2   /   waited=6s attempts=4
#   with ordering      waited=10s attempts=6
#
# The reason is the one written three paragraphs below, which was correct before anyone
# tested it: `After=tailscaled.service` orders against tailscaled having *started*, and a
# started tailscaled has not authenticated yet. The tailnet address arrives seconds later.
# Ordering therefore guarantees the wrong event.
#
# What does solve it is already here: the agent retries bind() for up to 90 seconds, which
# is why every boot in this project's history has come up regardless. The item is closed as
# decided against, not done — a directive that looks like it handles the race, and does not,
# is worse than no directive, because the next reader stops looking.
#
# DO NOT add `tailscale0.device`. systemd resolves any *.device unit name back to a
# device path, so it reads that as a device node at /tailscale0, which never appears.
# The job then blocks for the full DefaultTimeoutStartSec — measured at 89 seconds on
# the target host — before timing out and letting this unit start. It looks like it
# fixed the race, because a 90-second delay guarantees the VPN is up by then.
#
# Ordering on the real device unit (sys-subsystem-net-devices-tailscale0.device) is
# also insufficient: it signals that the *interface* exists, while bind() needs the
# *address*, which tailscaled assigns seconds later after authenticating.

[Service]
# exec rather than simple: systemd waits for execve to succeed, so a missing
# binary or unreadable config is reported as a start failure instead of the unit
# briefly appearing to run.
Type=exec
User=cueseek
Group=cueseek

ExecStart=/usr/local/bin/cueseekd -config /etc/cueseek/config.yaml

# SIGTERM is what the agent traps. It drains in-flight requests, closes event
# streams and waits for action bookkeeping — measured at well under two seconds
# with a stream open. 30s is generous headroom without approaching systemd's
# 90s default, after which it would escalate to SIGKILL mid-write.
KillSignal=SIGTERM
TimeoutStopSec=30s

Restart=on-failure
RestartSec=5s

# /var/lib/cueseek, created and chowned by systemd. The SQLite database and its
# -wal/-shm companions live here; it is the only writable path the agent has.
StateDirectory=cueseek
StateDirectoryMode=0750

# ---------------------------------------------------------------- hardening
#
# The agent needs four things: the D-Bus system socket, outbound TCP to services
# on this host, its state directory, and — since M3.6 — the kernel's own
# statistics under /proc. Everything else is removed.
#
# If the service fails to start after a distribution upgrade, relax in this
# order — SystemCallFilter first, then MemoryDenyWriteExecute — and report it
# rather than deleting the whole block.

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
# Other users' processes stay invisible. This is the half of /proc hardening that
# is about *other people's* business, and it is kept.
ProtectProc=invisible

# Changed from `pid` in M3.6, and it is a deliberate widening rather than a
# relaxation made to get something working.
#
# `ProcSubset=pid` mounts /proc with `subset=pid`, which hides every file that is
# not inside a per-process directory: /proc/stat, /proc/meminfo, /proc/loadavg,
# /proc/uptime. Those four *are* the host metrics feature. With the subset in
# place the agent reported storage and temperatures — read via statfs and
# /sys — and silently omitted CPU, memory and uptime, which is the correct
# behaviour for an unreadable source and a useless one for an operator.
#
# What this exposes: read-only, system-wide kernel statistics. What it does not
# expose: /proc/sys stays read-only (ProtectKernelTunables), /proc/kmsg stays
# gone (ProtectKernelLogs), module loading stays blocked, and other users'
# process directories stay hidden (ProtectProc, above). The agent runs
# unprivileged with an empty capability set, so kernel pointers in
# /proc/kallsyms read as zeroes to it under the default kptr_restrict.
#
# There is no narrower setting. systemd offers `pid` or `all`, with nothing in
# between, and no supported way to admit four files.
ProcSubset=all

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# AF_UNIX for the D-Bus system socket, AF_INET/AF_INET6 for the API listener and
# for polling service HTTP endpoints. Nothing else — no raw sockets, no netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The database and any key files are created 0600/0700 rather than group- or
# world-readable.
UMask=0077

[Install]
WantedBy=multi-user.target
