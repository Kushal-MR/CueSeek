/*
 * CueSeek — polkit authorisation rule.
 *
 * This file is the complete statement of what CueSeek may do to this machine.
 * An operator should be able to read it and know the ceiling without reading any
 * Go (ADR-0002). Keep it short. Never widen it for convenience.
 *
 * Install to:  /etc/polkit-1/rules.d/10-cueseek.rules   (root:root, 0644)
 *
 * REQUIRES polkit >= 0.106. Older polkit uses .pkla files, which cannot inspect
 * action details, which makes the per-unit allowlist below unenforceable — the
 * rule would degrade to "cueseek may restart ANY unit". install.sh refuses to
 * install on such a host rather than silently granting more than this file says.
 *
 * Everything returns NOT_HANDLED rather than NO, so this rule only ever adds
 * permissions and never revokes ones another rule granted.
 */

polkit.addRule(function (action, subject) {
    /* Nothing here applies to any user but the agent's own. */
    if (subject.user !== "cueseek") {
        return polkit.Result.NOT_HANDLED;
    }

    /* ---------------------------------------------------------------- units
     *
     * EDIT THIS LIST to match the units in your /etc/cueseek/config.yaml.
     *
     * The allowlist is deliberately duplicated: the agent enforces it too, from
     * its config file. Two independent copies is cheap defence in depth, and it
     * is why this file must NOT be generated from the config (ADR-0002). If the
     * two disagree, the narrower one wins, which is the safe direction.
     *
     * Use the exact unit name. M0 found the real name can differ from the one a
     * unit's description implies — qBittorrent's unit is `qbittorrent.service`,
     * not `qbittorrent-nox.service`. Check with:
     *
     *   systemctl list-units --type=service | grep -i <name>
     *
     * Empty as shipped, and that is deliberate. A fresh install grants nothing,
     * matching config.example.yaml's `services: []` — so the rule never claims
     * authority over a unit the operator did not ask for. Add yours here as you
     * add them to the config; both lists are enforced and must agree.
     *
     *   var allowedUnits = [
     *       "jellyfin.service",
     *       "qbittorrent.service"
     *   ];
     */
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var allowedUnits = [];

        /* The agent calls RestartUnit, StartUnit and StopUnit, which systemd
         * reports to polkit as "restart", "start" and "stop". try-restart and
         * reload-or-restart are listed because a future ReloadOrRestart would
         * otherwise fail as an authorisation error, which looks like a
         * misconfigured user rather than a missing verb.
         *
         * `stop` was deliberately absent until M3.1 and its addition is a real
         * widening: restart is self-healing, stop is not, so a stolen token can
         * now leave a service down. ADR-0002 Amendment 1 records what bounds it.
         *
         * Note what is still absent: enable, disable, mask. A stopped unit stays
         * enabled and returns on the next boot, so a stop costs one reboot
         * rather than persisting. Do not add them without amending the ADR. */
        var allowedVerbs = ["restart", "try-restart", "reload-or-restart",
                            "start", "stop"];

        if (allowedUnits.indexOf(action.lookup("unit")) >= 0 &&
            allowedVerbs.indexOf(action.lookup("verb")) >= 0) {
            return polkit.Result.YES;
        }

        /* Visible only at raised polkit verbosity. M0 confirmed these do not
         * appear in the journal at default settings, so do not rely on them
         * when debugging — use `cueseekd host restart <unit>`, which reports
         * whether the refusal came from the agent's allowlist or from polkit. */
        polkit.log("cueseek: DENY " + action.lookup("verb") + " " +
                   action.lookup("unit") + " (not in this rule's allowlist)");
        return polkit.Result.NOT_HANDLED;
    }

    /* ---------------------------------------------------------------- power
     *
     * ENABLED in M3.7 (ADR-0002 Amendment 2). Disabled until then, because
     * granting a service permission to reboot a machine it cannot ask to reboot
     * is a standing risk with no benefit — there was no code path calling logind
     * and the `host.power` scope guarded nothing.
     *
     * M0 proved these work: an unprivileged, session-less cueseek genuinely
     * rebooted the target host.
     *
     * ALL FOUR OR NONE. The *-multiple-sessions variants are what logind consults
     * when another user is logged in. A rule granting only the plain forms works
     * perfectly for whoever tests it alone and fails the first time somebody is
     * sitting at the console — a failure that arrives late, on someone else's
     * machine, and looks like a permissions bug rather than a missing line.
     *
     * Note what is absent, and is meant to stay absent: suspend and hibernate. A
     * suspended host is unreachable over the tailnet and cannot be woken by the
     * thing that suspended it, which turns a remote console into a way to lock
     * yourself out of your own machine.
     *
     * This is the one grant in this file with no allowlist behind it. A unit grant
     * is bounded to named units; there is no target narrower than the machine. The
     * bound is the `host.power` scope, which the agent enforces per device and
     * never grants by default.
     */
    var powerActions = [
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.reboot-multiple-sessions",
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.power-off-multiple-sessions"
    ];
    if (powerActions.indexOf(action.id) >= 0) {
        polkit.log("cueseek: ALLOW " + action.id);
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
